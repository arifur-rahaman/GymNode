# Copy to apps/web/.env.local and fill in. NEVER commit real values.
# For local development, get these from:  pnpm exec supabase status

# --- Supabase (public: safe in the browser, RLS protects the data) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase secret key (server only; bypasses RLS) ---
# Used ONLY to create / reset staff logins (Auth admin API) and, later, by background
# jobs and the device webhook. Never prefix it with NEXT_PUBLIC_, never commit it.
SUPABASE_SECRET_KEY=

# --- Public site address, used in links inside emails (sign-up, password reset) ---
# Leave empty locally; set to the real domain in production, e.g. https://app.gymnode.com.bd
NEXT_PUBLIC_SITE_URL=

# --- Demo deployment: shows a "demo version" banner and hides the site from search engines ---
NEXT_PUBLIC_DEMO_MODE=false

# --- Internal component gallery at /dev/ui ---
# Always on in development. Set to "true" to also show it in a production build.
ENABLE_DEV_UI=false

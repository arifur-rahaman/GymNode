# Copy to apps/web/.env.local and fill in. NEVER commit real values.
# For local development, get these from:  pnpm exec supabase status

# --- Supabase (public: safe in the browser, RLS protects the data) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase secret key (server only; bypasses RLS) ---
# Not used by the web app yet. From M6/M8 it is used ONLY by background jobs and the
# device webhook. Never prefix it with NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=

# --- Internal component gallery at /dev/ui ---
# Always on in development. Set to "true" to also show it in a production build.
ENABLE_DEV_UI=false
